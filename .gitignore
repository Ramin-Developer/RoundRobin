## Global .gitignore for .NET development
## Applies to all Git repositories on this machine.
## Register with: git config --global core.excludesfile "$env:USERPROFILE\.gitignore_global"

# -------------------------
# OS - Windows
# -------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -------------------------
# OS - macOS (cross-machine safety)
# -------------------------
.DS_Store
.AppleDouble
.LSOverride

# -------------------------
# Visual Studio
# -------------------------
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vs/
Generated\ Files/
.localhistory/
MigrationBackup/

# -------------------------
# Build results
# -------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# -------------------------
# .NET / NuGet
# -------------------------
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# -------------------------
# Test & Coverage
# -------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
